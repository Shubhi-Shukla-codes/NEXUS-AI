# ==============================================================================
# NEXUS - Environment Configuration Template
# Offline-First, Privacy-Preserving Knowledge Intelligence Platform
# ==============================================================================

# Application Settings
NEXUS_DEBUG=false
NEXUS_SECRET_KEY=change-this-to-a-secure-random-string-in-production

# LLM Runtime (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_LLM_MODEL=qwen2.5:1.5b

# Embeddings (Sentence Transformers)
NEXUS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Paths (Leave empty to use project defaults)
# NEXUS_DATA_DIR=
